# Launch/indexing gate. Keep false on preview/staging. Set true in the
# production BUILD environment only after the launch checklist passes.
SITE_INDEXING_ENABLED=false
# Search discovery is separate from model-training crawling. The conservative
# default leaves GPTBot blocked while OAI-SearchBot can crawl a launched site.
SITE_ALLOW_MODEL_TRAINING=false

# Optional foundation testing adapter. OFF by default; not a public MCP service.
SC_AGENT_READY_HTTP_ENABLED=false
# Set a random secret of at least 32 characters on the server only. No default key.
SC_AGENT_READY_HTTP_KEY=
# Optional redacted timing/outcome events; never query/configuration/brief contents.
SC_AGENT_READY_LOG_EVENTS=false

# Existing site configuration; retain your current values in the hosting environment.
NEXT_PUBLIC_SITE_URL=https://sitecomms.com.au
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=
# The retired output-log route no longer uses Supabase. Historical data is untouched.
